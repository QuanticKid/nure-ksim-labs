<?xml version="1.0" encoding="us-ascii"?>
<!DOCTYPE experiments SYSTEM "behaviorspace.dtd">
<experiments>
  <experiment name="evap" repetitions="5" runMetricsEveryStep="false">
    <setup>setup</setup>
    <go>go</go>
    <timeLimit steps="30000"/>
    <exitCondition>not any? patches with [food &gt; 0]</exitCondition>
    <metric>ticks</metric>
    <enumeratedValueSet variable="evaporation-rate"><value value="5"/><value value="10"/><value value="15"/><value value="20"/><value value="25"/><value value="30"/></enumeratedValueSet>
    <enumeratedValueSet variable="population"><value value="125"/></enumeratedValueSet>
    <enumeratedValueSet variable="diffusion-rate"><value value="50"/></enumeratedValueSet>
  </experiment>
</experiments>
